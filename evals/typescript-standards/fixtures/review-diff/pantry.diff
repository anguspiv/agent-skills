+import { describe, it, expect, vi } from 'vitest';
+import loadInventory, { findLowStock } from './inventory';
+
+vi.mock('node:fs', () => ({
+  readFileSync: () => JSON.stringify({ items: [{ id: 'a', name: 'salt', quantity: 1 }] }),
+}));
+
+describe('inventory', () => {
+  it('loads', () => {
+    const stock = loadInventory('/any/path.json');
+    expect(stock.items.length).toBe(1);
+  });
+
+  it('finds low stock', () => {
+    const stock = { items: [{ id: 'a', name: 'salt', quantity: 1 }, { id: 'b', name: 'rice', quantity: 50 }] };
+    expect(findLowStock(stock, 5).length).toBe(1);
+  });
+});
