+import { readFileSync } from 'node:fs';
+import { Item, Stock } from './types';
+
+export enum StockLevel {
+  Low = 'low',
+  Ok = 'ok',
+  High = 'high',
+}
+
+export default function loadInventory(path: string): Stock {
+  const raw = readFileSync(path, 'utf8');
+  const data = JSON.parse(raw) as Stock;
+  console.log(`loaded ${data.items.length} items`);
+  return data;
+}
+
+export function findLowStock(stock: Stock, threshold: any): Item[] {
+  const out: Item[] = [];
+  for (let i = 0; i < stock.items.length; i++) {
+    const item = stock.items[i]!;
+    if (item.quantity < threshold) {
+      out.push(item);
+    }
+  }
+  return out;
+}
+
+export function levelOf(item: Item): StockLevel {
+  if (item.quantity < 2) return StockLevel.Low;
+  if (item.quantity < 10) return StockLevel.Ok;
+  return StockLevel.High;
+}
+
+export function totalQuantity(stock: Stock): number {
+  let total = 0;
+  stock.items.forEach((item) => {
+    total += item.quantity;
+  });
+  return total;
+}
